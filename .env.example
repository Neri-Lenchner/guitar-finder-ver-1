JWT_SECRET_KEY=your_jwt_secret_here
OPENAI_API_KEY=your_openai_api_key_here
REVERB_API_TOKEN=your_reverb_api_token_here
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
ETSY_API_KEY=your_etsy_keystring:your_etsy_shared_secret

# Rate limiting (optional — defaults shown; lower these to clamp down fast during an attack)
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=20

# Comma-separated list of origins allowed to call the API (defaults cover the live site,
# Vite dev server, and local Docker Compose if unset)
CORS_ALLOWED_ORIGINS=https://giutarfinder.up.railway.app,http://localhost:5173,http://localhost
