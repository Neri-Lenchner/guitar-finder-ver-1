JWT_SECRET_KEY=your_jwt_secret_here
OPENAI_API_KEY=your_openai_api_key_here
REVERB_API_TOKEN=your_reverb_api_token_here

# Rate limiting (optional — defaults shown; lower these to clamp down fast during an attack)
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=20
